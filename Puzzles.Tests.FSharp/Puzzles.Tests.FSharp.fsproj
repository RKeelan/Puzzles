<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>

    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="UtilTests.fs" />
    <Compile Include="NumbersTests.fs" />
    <Compile Include="PrimesTests.fs" />
    <Compile Include="TimeTests.fs" />
    <Compile Include="BigIntTests.fs" />
    <Compile Include="StringsTests.fs" />
    <Compile Include="CombinatronicsTests.fs" />
    <Compile Include="SearchTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Euler\Euler.fsproj" />
  </ItemGroup>

</Project>
